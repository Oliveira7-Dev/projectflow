# NUNCA envie este arquivo com valores reais para o GitHub.
SECRET_KEY=gere_uma_chave_forte
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# E-mail SMTP — exemplo recomendado para Brevo
# SMTP_USER = Login SMTP mostrado no painel da Brevo
# SMTP_PASSWORD = SMTP Key da Brevo (não é a senha da conta e não é API Key)
# SMTP_FROM = endereço cadastrado e VERIFICADO em Brevo > Senders & IP > Senders
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu_login_smtp_brevo
SMTP_PASSWORD=sua_smtp_key_brevo
SMTP_FROM=noreplyprojectflow1@gmail.com
SMTP_FROM_NAME=ProjectFlow
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
